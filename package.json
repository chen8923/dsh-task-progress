{
  "name": "dsh-task-progress",
  "version": "0.1.0",
  "private": true,
  "description": "Live progress for long-running DSH tasks: a script reports structured progress to a per-session directory, and the Web UI shows it in a floating overlay and a right-sidebar tab.",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "progress",
    "background-job",
    "long-running-task"
  ],
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "dsh-progress": "bin/dsh-progress.mjs"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/client.js.map",
    "bin/dsh-progress.mjs",
    "cordis.patch.yml",
    "docs",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "node tools/test.mjs",
    "test:runner": "node --test test/"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [],
      "external": [
        "react",
        "react/jsx-runtime",
        "@deepseek-ai/cordis",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "devDependencies": {
    "tsdown": "^0.15.0",
    "typescript": "^5.9.0"
  }
}
